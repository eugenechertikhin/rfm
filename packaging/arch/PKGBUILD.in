# Maintainer: Eugene Chertikhin <e.chertikhin@gmail.com>
pkgname=rfm
pkgver=@VERSION@
pkgrel=1
pkgdesc="Lightweight terminal file manager"
arch=('x86_64' 'aarch64')
url="https://github.com/eugenechertikhin/rfm"
license=('GPL-3.0-or-later')
depends=('glibc')
optdepends=('openssh: sftp locations' 'curl: ftp/http locations')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
